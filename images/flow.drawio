<mxfile host="app.diagrams.net"><diagram name="Harborlight · how one email attachment locked the whole practice"><mxGraphModel dx="1200" dy="900" grid="0" background="#0f141c" page="1" pageWidth="1300" pageHeight="1252"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Harborlight · how one email attachment locked the whole practice" style="text;html=1;fontSize=22;fontStyle=1;fontColor=#eef2f7;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1100" height="34" as="geometry"/></mxCell><mxCell id="lg0" value="Attacker / outside" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontColor=#eef2f7;fillColor=#3a1d1f;strokeColor=#ff6b5e;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="180" height="28" as="geometry"/></mxCell><mxCell id="lg1" value="Staff PC" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontColor=#eef2f7;fillColor=#3a3018;strokeColor=#f2b134;" vertex="1" parent="1"><mxGeometry x="230" y="70" width="180" height="28" as="geometry"/></mxCell><mxCell id="lg2" value="File server" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontColor=#eef2f7;fillColor=#16283d;strokeColor=#5aa9ff;" vertex="1" parent="1"><mxGeometry x="420" y="70" width="180" height="28" as="geometry"/></mxCell><mxCell id="lg3" value="Main server (logins)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontColor=#eef2f7;fillColor=#2a1f3d;strokeColor=#b48cff;" vertex="1" parent="1"><mxGeometry x="610" y="70" width="180" height="28" as="geometry"/></mxCell><mxCell id="lg4" value="Investigator" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontColor=#eef2f7;fillColor=#123236;strokeColor=#4fd1d9;" vertex="1" parent="1"><mxGeometry x="800" y="70" width="180" height="28" as="geometry"/></mxCell><mxCell id="lg5" value="Decision / gap" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontColor=#eef2f7;fillColor=#1b222c;strokeColor=#6b7a8c;" vertex="1" parent="1"><mxGeometry x="990" y="70" width="180" height="28" as="geometry"/></mxCell><mxCell id="s" value="&lt;b&gt;Start:&lt;/b&gt; an email with a fake disk-image&lt;br&gt;file reaches a staff member" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=14;fontColor=#eef2f7;fillColor=#3a1d1f;strokeColor=#ff6b5e;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="470" y="130" width="380" height="74" as="geometry"/></mxCell><mxCell id="a" value="She opens it. Hidden code runs and starts&lt;br&gt;calling the attacker's server for orders." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=14;fontColor=#eef2f7;fillColor=#3a3018;strokeColor=#f2b134;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="470" y="244" width="380" height="74" as="geometry"/></mxCell><mxCell id="b" value="It gives itself &lt;b&gt;full control of her PC&lt;/b&gt;." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=14;fontColor=#eef2f7;fillColor=#3a3018;strokeColor=#f2b134;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="470" y="358" width="380" height="74" as="geometry"/></mxCell><mxCell id="q1" value="Is her everyday password&lt;br&gt;also an admin password?" style="rhombus;whiteSpace=wrap;html=1;fontSize=14;fontColor=#eef2f7;fillColor=#1b222c;strokeColor=#6b7a8c;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="510" y="472" width="300" height="120" as="geometry"/></mxCell><mxCell id="c" value="Her password opens the &lt;b&gt;file server&lt;/b&gt;.&lt;br&gt;A script switches its antivirus off." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=14;fontColor=#eef2f7;fillColor=#16283d;strokeColor=#5aa9ff;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="470" y="632" width="380" height="74" as="geometry"/></mxCell><mxCell id="d" value="The same password opens the &lt;b&gt;main server&lt;/b&gt;.&lt;br&gt;The database of every account is copied." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=14;fontColor=#eef2f7;fillColor=#2a1f3d;strokeColor=#b48cff;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="470" y="746" width="380" height="74" as="geometry"/></mxCell><mxCell id="e" value="Shared files (patient and claims data)&lt;br&gt;are copied to MEGA. Backups are deleted." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=14;fontColor=#eef2f7;fillColor=#3a1d1f;strokeColor=#ff6b5e;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="470" y="860" width="380" height="74" as="geometry"/></mxCell><mxCell id="f" value="&lt;b&gt;Ransomware locks all three computers.&lt;/b&gt;&lt;br&gt;A new admin account is made." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=14;fontColor=#eef2f7;fillColor=#3a1d1f;strokeColor=#ff6b5e;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="470" y="974" width="380" height="74" as="geometry"/></mxCell><mxCell id="z" value="&lt;b&gt;End:&lt;/b&gt; the main server is still taking&lt;br&gt;the attacker's orders when the data ends." style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=14;fontColor=#eef2f7;fillColor=#3a1d1f;strokeColor=#ff6b5e;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="470" y="1088" width="380" height="74" as="geometry"/></mxCell><mxCell id="n1" value="Hours later, security software removes&lt;br&gt;the PC's attack code. &lt;b&gt;The alert reaches nobody.&lt;/b&gt;" style="rounded=1;arcSize=14;dashed=1;whiteSpace=wrap;html=1;fontSize=14;fontColor=#eef2f7;fillColor=#1b222c;strokeColor=#6b7a8c;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="940" y="347.0" width="320" height="96" as="geometry"/></mxCell><mxCell id="n2" value="&lt;i&gt;The gap.&lt;/i&gt; Separate admin accounts&lt;br&gt;with a second sign-in step stop it here." style="rounded=1;arcSize=14;dashed=1;whiteSpace=wrap;html=1;fontSize=14;fontColor=#eef2f7;fillColor=#1b222c;strokeColor=#6b7a8c;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="940" y="484.0" width="320" height="96" as="geometry"/></mxCell><mxCell id="h" value="&lt;b&gt;The hunter starts here.&lt;/b&gt;&lt;br&gt;Three locked computers and a new admin.&lt;br&gt;Traced back to one attachment, step by step." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=14;fontColor=#eef2f7;fillColor=#123236;strokeColor=#4fd1d9;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="50" y="963.0" width="320" height="96" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c9d3df;fontColor=#eef2f7;fontSize=13;fontStyle=1;labelBackgroundColor=#0f141c;" edge="1" parent="1" source="s" target="a"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c9d3df;fontColor=#eef2f7;fontSize=13;fontStyle=1;labelBackgroundColor=#0f141c;" edge="1" parent="1" source="a" target="b"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c9d3df;fontColor=#eef2f7;fontSize=13;fontStyle=1;labelBackgroundColor=#0f141c;" edge="1" parent="1" source="b" target="q1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c9d3df;fontColor=#eef2f7;fontSize=13;fontStyle=1;labelBackgroundColor=#0f141c;" edge="1" parent="1" source="q1" target="c"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c9d3df;fontColor=#eef2f7;fontSize=13;fontStyle=1;labelBackgroundColor=#0f141c;" edge="1" parent="1" source="c" target="d"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c9d3df;fontColor=#eef2f7;fontSize=13;fontStyle=1;labelBackgroundColor=#0f141c;" edge="1" parent="1" source="d" target="e"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c9d3df;fontColor=#eef2f7;fontSize=13;fontStyle=1;labelBackgroundColor=#0f141c;" edge="1" parent="1" source="e" target="f"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c9d3df;fontColor=#eef2f7;fontSize=13;fontStyle=1;labelBackgroundColor=#0f141c;" edge="1" parent="1" source="f" target="z"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c9d3df;fontColor=#eef2f7;fontSize=13;fontStyle=1;labelBackgroundColor=#0f141c;dashed=1;" edge="1" parent="1" source="b" target="n1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c9d3df;fontColor=#eef2f7;fontSize=13;fontStyle=1;labelBackgroundColor=#0f141c;dashed=1;" edge="1" parent="1" source="q1" target="n2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="trace back" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c9d3df;fontColor=#eef2f7;fontSize=13;fontStyle=1;labelBackgroundColor=#0f141c;dashed=1;" edge="1" parent="1" source="h" target="f"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>